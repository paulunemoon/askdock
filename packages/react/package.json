{
  "name": "@askdock/react",
  "version": "1.0.0",
  "description": "The Askdock widget for React — pill or bubble launcher, popup or side panel, fully themeable.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@askdock/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulunemoon/askdock.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/paulunemoon/askdock#readme",
  "bugs": "https://github.com/paulunemoon/askdock/issues",
  "author": "Pauline Mila-Alonso",
  "keywords": [
    "chatbot",
    "chat-widget",
    "rag",
    "grounded",
    "site-search",
    "ai-sdk",
    "gemini",
    "claude",
    "openai",
    "support"
  ],
  "publishConfig": {
    "access": "public"
  }
}
