{
  "name": "@askdock/server",
  "version": "1.0.0",
  "description": "Web handler for Askdock — Next.js route handlers, Hono, Bun, Deno, or plain fetch.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@askdock/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulunemoon/askdock.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/paulunemoon/askdock#readme",
  "bugs": "https://github.com/paulunemoon/askdock/issues",
  "author": "Pauline Mila-Alonso",
  "keywords": [
    "chatbot",
    "chat-widget",
    "rag",
    "grounded",
    "site-search",
    "ai-sdk",
    "gemini",
    "claude",
    "openai",
    "support"
  ]
}
