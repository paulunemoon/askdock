{
  "name": "@askdock/core",
  "version": "1.0.0",
  "description": "Grounded chat engine: answers only from a site's own content. Provider-agnostic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "ai": "^7.0.73"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.49",
    "@ai-sdk/openai": "^4.0.45"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulunemoon/askdock.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/paulunemoon/askdock#readme",
  "bugs": "https://github.com/paulunemoon/askdock/issues",
  "author": "Pauline Mila-Alonso",
  "keywords": [
    "chatbot",
    "chat-widget",
    "rag",
    "grounded",
    "site-search",
    "ai-sdk",
    "gemini",
    "claude",
    "openai",
    "support"
  ]
}
